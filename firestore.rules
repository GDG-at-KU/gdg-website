rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    match /members/{memberId} {
      allow read: if request.auth != null && request.auth.uid == memberId;
      allow create, update: if request.auth != null && request.auth.uid == memberId;
      allow delete: if false;
    }

    match /memberDirectory/{memberId} {
      allow read: if request.auth != null;
      allow create, update: if request.auth != null
        && request.auth.uid == memberId
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.keys().hasOnly([
          'uid', 'displayName', 'major', 'graduationYear',
          'leetCodeUsername', 'interests', 'updatedAt'
        ]);
      allow delete: if false;
    }

    match /attendance/{recordId} {
      allow read: if request.auth != null && resource.data.memberId == request.auth.uid;
      allow create: if request.auth != null && request.resource.data.memberId == request.auth.uid;
      allow update: if request.auth != null && resource.data.memberId == request.auth.uid;
      allow delete: if false;
    }
  }
}
