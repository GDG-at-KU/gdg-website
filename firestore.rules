rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    match /members/{memberId} {
      allow read: if request.auth != null && request.auth.uid == memberId;
      allow create, update: if request.auth != null && request.auth.uid == memberId;
      allow delete: if false;
    }

    match /attendance/{recordId} {
      allow read: if request.auth != null && resource.data.memberId == request.auth.uid;
      allow create: if request.auth != null && request.resource.data.memberId == request.auth.uid;
      allow update: if request.auth != null && resource.data.memberId == request.auth.uid;
      allow delete: if false;
    }
  }
}
